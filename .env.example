# Copy this file to .env for running refresh_chargers.py / check_charger_health.py locally.
# .env is already gitignored -- never commit real keys.

# Required for refresh_chargers.py and check_charger_health.py.
# Free key: https://openchargemap.org/site/developerinfo
OCM_API_KEY=

# Used by the Streamlit app for live weather (falls back to Open-Meteo, keyless, if unset).
# Free key: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Optional: enables the AI narration of the range estimate. The app works fully without it.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
