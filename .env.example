# Copy to .env (already gitignored). Never commit real keys.

# Open Charge Map: powers the daily national charger refresh and health check.
# Free key: https://openchargemap.org/site/developerinfo
OCM_API_KEY=

# OpenWeatherMap: live weather along the route (falls back to keyless Open-Meteo if unset).
# Free key: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Optional: Gemini writes the plain-English range explanation. Marga works fully without it.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
